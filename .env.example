# ── ضروری ──
# رمز ورود به برنامه (حتماً یک رمز قوی بگذارید)
ZOZO_PASSWORD=

# ── ظاهر ──
# نام برنامه که بالای صفحه نمایش داده می‌شود
ZOZO_APP_NAME=زوزو
# نام همسرتان برای پیام صبح‌بخیر (اختیاری)
ZOZO_OWNER=
# واحد پول: تومان یا ریال
ZOZO_CURRENCY=تومان

# ── ربات بله (برای یادآوری روی گوشی) ──
# توکن را از «بات‌فادر» در پیام‌رسان بله بگیرید
BALE_BOT_TOKEN=
# شناسه‌ی گفتگو (با فرستادن /id به ربات به دست می‌آید؛ چندتا را با ویرگول جدا کنید)
BALE_ALLOWED_CHAT_IDS=
# ساعت ارسال خلاصه‌ی صبحگاهی
DAILY_BRIEF_TIME=08:00

# ── رصد خبر ──
# هر چند دقیقه یک بار خبرها دریافت شوند (0 = خاموش)
FEED_INTERVAL_MIN=20
# خبرهای قدیمی‌تر از چند روز پاک شوند (نشان‌دارها پاک نمی‌شوند)
FEED_KEEP_DAYS=30

# ── تیزرساز ──
# حداکثر حجم هر فایل بارگذاری (مگابایت)
ZOZO_MAX_UPLOAD_MB=500
# تعداد هسته برای ساخت ویدیو (روی پلن نیم‌هسته 1 بگذارید)
ZOZO_RENDER_THREADS=2

# ── فقط برای اجرای روی کامپیوتر خودتان ──
# ZOZO_DATA_DIR=data

# ── هوش مصنوعی (اختیاری؛ فعلاً خالی بگذارید) ──
# سرویس سازگار با OpenAI (مثلاً مدل متن‌باز روی سرور خودتان):
# ZOZO_LLM_BASE_URL=https://example.com/v1
# ZOZO_LLM_MODEL=
# ZOZO_LLM_API_KEY=
# یا Claude:
# ANTHROPIC_API_KEY=
